menu "Example configuration"

config EXAMPLE_I2C_SDA
    int "I2C SDA pin"
    range 0 48
    default 21

config EXAMPLE_I2C_SCL
    int "I2C SCL pin"
    range 0 48
    default 22

config EXAMPLE_I2C_ADDR
    hex "I2C address of the display"
    range 0x08 0x77
    default 0x3C
    help
        The 7-bit address of the SSD1306: 0x3c when the D/C pin of the module
        is tied to ground, 0x3d when it is tied to VCC.

endmenu
